{
  "name": "agent-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --filter @moesin-lab/agent-nexus dev",
    "build": "tsc --build && corepack pnpm --filter @moesin-lab/agent-nexus bundle",
    "pack:cli": "corepack pnpm --dir packages/cli pack",
    "verify:pack:cli": "node scripts/verify-packed-cli.mjs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:e2e:discord": "node scripts/discord-e2e-runner.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
